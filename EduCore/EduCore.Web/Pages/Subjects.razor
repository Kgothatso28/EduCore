@page "/subjects"
@inject AuthService Auth

<h2>Subjects</h2>

@if (!Auth.IsAuthenticated)
{
    <p>Please <a href="/login">login</a> to view subjects.</p>
}
else
{
    <div class="toolbar">
        <input placeholder="Search by name or code" @bind="query" />
        <button class="btn" @onclick="Search">Search</button>
        <button class="btn" @onclick="CreateDemo">Add Subject</button>
    </div>

    <table class="table">
        <thead>
            <tr><th>Code</th><th>Name</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var s in subjectsPage)
            {
                <tr>
                    <td>@s.Code</td>
                    <td>@s.Name</td>
                    <td><button class="btn" @onclick="() => View(s.Id)">View</button></td>
                </tr>
            }
        </tbody>
    </table>

    <div class="pagination">
        <button class="btn" @onclick="PrevPage" disabled="@(_page==1)">Prev</button>
        <span>Page @_page</span>
        <button class="btn" @onclick="NextPage" disabled="@(subjects.Count <= _page*_pageSize)">Next</button>
    </div>
}

@code {
    private List<Models.SubjectModel> subjects = new();
    private IEnumerable<Models.SubjectModel> subjectsPage => subjects.Skip((_page-1)*_pageSize).Take(_pageSize);
    private int _page = 1;
    private int _pageSize = 10;
    private string query = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated) return;
        await LoadSubjects();
    }

    private async Task LoadSubjects()
    {
        var client = Auth.CreateApiClient();
        try
        {
            var result = await client.GetFromJsonAsync<List<Models.SubjectModel>>("/api/v1/subjects");
            if (result != null)
            {
                var tenant = Auth.TenantId;
                if (!string.IsNullOrEmpty(tenant)) result = result.Where(r => r.TenantId == tenant).ToList();
                subjects = result;
            }
        }
        catch
        {
            // ignore
        }
    }

    private async Task Search()
    {
        _page = 1;
        if (string.IsNullOrWhiteSpace(query)) await LoadSubjects();
        else subjects = subjects.Where(s => s.Name.Contains(query, StringComparison.OrdinalIgnoreCase) || s.Code.Contains(query, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private void PrevPage() => _page = Math.Max(1, _page-1);
    private void NextPage() => _page++;

    private void View(Guid id)
    {
        NavigationManager.NavigateTo($"/subjects/{id}");
    }

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    private async Task CreateDemo()
    {
        var s = new Models.SubjectModel
        {
            Code = "SUB" + (subjects.Count + 1),
            Name = "New Subject",
            TenantId = Auth.TenantId ?? "educore-academy"
        };
        var client = Auth.CreateApiClient();
        var resp = await client.PostAsJsonAsync("/api/v1/subjects", s);
        if (resp.IsSuccessStatusCode) await LoadSubjects();
    }
}
