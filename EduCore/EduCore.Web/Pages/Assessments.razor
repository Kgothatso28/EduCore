@page "/assessments"
@inject AuthService Auth

<h2>Assessments</h2>

@if (!Auth.IsAuthenticated)
{
    <p>Please <a href="/login">login</a> to view assessments.</p>
}
else
{
    <div class="toolbar">
        <input placeholder="Search by title or subject" @bind="query" />
        <button class="btn" @onclick="Search">Search</button>
        <button class="btn" @onclick="CreateDemo">Add Assessment</button>
    </div>

    @if (isLoading) { <p>Loading...</p> }
    else if (!string.IsNullOrEmpty(errorMessage)) { <p class="error">@errorMessage</p> }
    else
    {
        @if (assessments.Count == 0)
        {
            <p>No assessments found.</p>
        }
        else
        {
            <table class="table">
                <thead><tr><th>Title</th><th>Subject</th><th>Class</th><th>Type</th><th>Date</th></tr></thead>
                <tbody>
                    @foreach (var a in assessmentsPage)
                    {
                        <tr>
                            <td>@a.Title</td>
                            <td>@a.SubjectName</td>
                            <td>@a.ClassName</td>
                            <td>@a.Type</td>
                            <td>@a.Date.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="pagination">
                <button class="btn" @onclick="PrevPage" disabled="@(_page==1)">Prev</button>
                <span>Page @_page</span>
                <button class="btn" @onclick="NextPage" disabled="@(assessments.Count <= _page*_pageSize)">Next</button>
            </div>
        }
    }
}

@code {
    private List<Models.AssessmentModel> assessments = new();
    private IEnumerable<Models.AssessmentModel> assessmentsPage => assessments.Skip((_page-1)*_pageSize).Take(_pageSize);
    private int _page = 1;
    private int _pageSize = 10;
    private string query = string.Empty;
    private bool isLoading = false;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated) return;
        await LoadAssessments();
    }

    private async Task LoadAssessments()
    {
        isLoading = true; errorMessage = string.Empty;
        try
        {
            var client = Auth.CreateApiClient();
            var result = await client.GetFromJsonAsync<List<Models.AssessmentModel>>("/api/v1/assessments");
            if (result != null)
            {
                var tenant = Auth.TenantId;
                if (!string.IsNullOrEmpty(tenant)) result = result.Where(r => r.TenantId == tenant).ToList();
                assessments = result;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load assessments: " + ex.Message;
        }
        finally { isLoading = false; }
    }

    private async Task Search()
    {
        _page = 1;
        if (string.IsNullOrWhiteSpace(query)) await LoadAssessments();
        else assessments = assessments.Where(a => a.Title.Contains(query, StringComparison.OrdinalIgnoreCase) || a.SubjectName.Contains(query, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private void PrevPage() => _page = Math.Max(1, _page-1);
    private void NextPage() => _page++;

    private async Task CreateDemo()
    {
        var dto = new Models.AssessmentModel
        {
            Title = "New Assessment",
            SubjectName = "General",
            ClassName = "Demo Class",
            Type = "Assignment",
            Date = DateTime.UtcNow.Date,
            MaxMark = 100,
            TenantId = Auth.TenantId ?? string.Empty
        };
        var client = Auth.CreateApiClient();
        var resp = await client.PostAsJsonAsync("/api/v1/assessments", dto);
        if (resp.IsSuccessStatusCode) await LoadAssessments();
    }
}
