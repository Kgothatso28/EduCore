@page "/staff"
@inject AuthService Auth

<h2>Staff</h2>

@if (!Auth.IsAuthenticated)
{
    <p>Please <a href="/login">login</a> to view staff.</p>
}
else
{
    <div class="toolbar">
        <input placeholder="Search by name or number" @bind="query" />
        <button class="btn" @onclick="Search">Search</button>
        <button class="btn" @onclick="CreateDemo">Add Staff</button>
    </div>

    <table class="table">
        <thead>
            <tr><th>Staff No</th><th>Name</th><th>Role</th><th>Email</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var s in staffPage)
            {
                <tr>
                    <td>@s.StaffNumber</td>
                    <td>@s.FirstName @s.LastName</td>
                    <td>@s.Role</td>
                    <td>@s.Email</td>
                    <td><button class="btn" @onclick="() => View(s.Id)">View</button></td>
                </tr>
            }
        </tbody>
    </table>

    <div class="pagination">
        <button class="btn" @onclick="PrevPage" disabled="@(_page==1)">Prev</button>
        <span>Page @_page</span>
        <button class="btn" @onclick="NextPage" disabled="@(staff.Count <= _page*_pageSize)">Next</button>
    </div>
}

@code {
    private List<Models.StaffModel> staff = new();
    private IEnumerable<Models.StaffModel> staffPage => staff.Skip((_page-1)*_pageSize).Take(_pageSize);
    private int _page = 1;
    private int _pageSize = 10;
    private string query = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated) return;
        await LoadStaff();
    }

    private async Task LoadStaff()
    {
        var client = Auth.CreateApiClient();
        try
        {
            var result = await client.GetFromJsonAsync<List<Models.StaffModel>>("/api/v1/staff");
            if (result != null)
            {
                var tenant = Auth.TenantId;
                if (!string.IsNullOrEmpty(tenant)) result = result.Where(r => r.TenantId == tenant).ToList();
                staff = result;
            }
        }
        catch
        {
            // ignore
        }
    }

    private async Task Search()
    {
        _page = 1;
        if (string.IsNullOrWhiteSpace(query)) await LoadStaff();
        else staff = staff.Where(s => s.FirstName.Contains(query, StringComparison.OrdinalIgnoreCase) || s.LastName.Contains(query, StringComparison.OrdinalIgnoreCase) || s.StaffNumber.Contains(query, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private void PrevPage() => _page = Math.Max(1, _page-1);
    private void NextPage() => _page++;

    private void View(Guid id)
    {
        NavigationManager.NavigateTo($"/staff/{id}");
    }

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    private async Task CreateDemo()
    {
        var s = new Models.StaffModel
        {
            StaffNumber = "T" + (2000 + staff.Count + 1),
            FirstName = "New",
            LastName = "Staff",
            Email = "newstaff@example.com",
            Role = "Teacher",
            TenantId = Auth.TenantId ?? "educore-academy"
        };
        var client = Auth.CreateApiClient();
        var resp = await client.PostAsJsonAsync("/api/v1/staff", s);
        if (resp.IsSuccessStatusCode) await LoadStaff();
    }
}
